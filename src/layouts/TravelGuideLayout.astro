---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import StatusStrip from '../components/StatusStrip.astro';
import Footer from '../components/Footer.astro';
import { travelFacts, travelSources } from '../data/travel';
import '../styles/travel-guide.css';
interface Props {
  title: string; description: string; page: 'getting-here' | 'travel-info';
  heading: string; emphasis: string; intro: string;
  sections: { id: string; label: string }[];
}
const { title, description, page, heading, emphasis, intro, sections } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={`https://pohnpeiisland.com/${page}`}>
  <a href="#travel-guide" class="skip-link">Skip to travel guide</a>
  <Nav /><StatusStrip />
  <main id="travel-guide" tabindex="-1" class="travel-guide pt-[116px]">
    <section class="px-6 pt-14 pb-12 md:pt-20 md:pb-16 bg-sand">
      <div class="max-w-6xl mx-auto grid md:grid-cols-[1.5fr_1fr] gap-10 md:gap-16 items-end">
        <div><p class="tg-eyebrow">Pohnpei / {page === 'getting-here' ? 'Getting here' : 'Travel essentials'}</p>
          <h1 class="font-headline text-6xl md:text-7xl lg:text-8xl leading-[.98] tracking-tight mb-6">{heading}<br /><em class="text-ochre-deep">{emphasis}</em></h1>
          <p class="text-basalt/80 leading-relaxed max-w-xl">{intro}</p>
          <a href={`#${sections[0].id}`} class="tg-button bg-basalt text-sand hover:bg-lagoon mt-7">{page === 'getting-here' ? 'Find your route ↓' : 'Start with entry & documents ↓'}</a>
        </div>
        <aside class="border-t-2 border-ochre-deep pt-6"><slot name="aside" />
          <dl class="flex flex-wrap justify-between gap-x-4 gap-y-4 border-t border-basalt/20 mt-6 pt-5">
            <div><dt class="text-xs text-basalt/75 mb-2">Airport</dt><dd class="font-headline text-2xl lg:text-3xl">{travelFacts.airport}</dd></div>
            <div><dt class="text-xs text-basalt/75 mb-2">Local time</dt><dd class="font-headline text-2xl lg:text-3xl whitespace-nowrap">{travelFacts.timeZone}</dd></div>
            <div><dt class="text-xs text-basalt/75 mb-2">Currency</dt><dd class="font-headline text-2xl lg:text-3xl">{travelFacts.currency}</dd></div>
          </dl>
        </aside>
      </div>
    </section>
    <div class="px-6 bg-sand-bright border-y border-basalt/15"><div class="max-w-6xl mx-auto py-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
      <p class="text-xs leading-relaxed">Independent guide · <a class="tg-link" href={page === 'getting-here' ? travelSources.tourismArrival : travelSources.tourismEssentials}>Official Pohnpei tourism guidance ↗</a></p>
      <nav aria-label="Travel guides" class="flex flex-wrap gap-x-6 text-sm">
        <a class="tg-page-link" aria-current={page === 'getting-here' ? 'page' : undefined} href="/getting-here">Getting Here</a>
        <a class="tg-page-link" aria-current={page === 'travel-info' ? 'page' : undefined} href="/travel-info">Travel Essentials</a>
        <a class="tg-page-link" href="/places-to-stay">Places to Stay →</a>
      </nav>
    </div></div>
    <nav aria-label="On this page" class="px-6 border-b border-basalt/15"><div class="max-w-6xl mx-auto flex flex-wrap gap-x-7 py-2 text-sm">{sections.map(({ id, label }) => <a href={`#${id}`} class="tg-page-link">{label}</a>)}</div></nav>
    <slot />
  </main><Footer />
</BaseLayout>
