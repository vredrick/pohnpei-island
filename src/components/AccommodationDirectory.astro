---
import { accommodations, staySources } from '../data/accommodations';
const phoneLabel = (phone: string) => phone.replace(/^(\+691)(\d{3})(\d{4})$/, '$1 $2 $3');
---
<section id="stays" class="px-6 py-16 md:py-24 bg-sand-bright" aria-labelledby="stays-heading">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div><p class="eyebrow">01 / The directory</p><h2 id="stays-heading" class="font-headline text-4xl md:text-5xl leading-tight">Find your <em class="text-ochre-deep">island base.</em></h2></div>
      <p class="text-basalt/80 leading-relaxed md:pt-8">Ten properties from the tourism office’s directory, arranged alphabetically. Compare location and published features, then contact your shortlist for a quote.</p>
    </div>
    <div id="stay-filters" hidden class="border-y border-basalt/20 py-6 mb-6">
      <div class="grid sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_auto] gap-4 items-end">
        <div><label for="stay-search">Property name</label><input id="stay-search" type="search" placeholder="Search the directory" autocomplete="off" /></div>
        <div><label for="stay-area">Area</label><select id="stay-area"><option value="all">All areas</option><option value="Kolonia">Kolonia</option><option value="Nett">Nett</option></select></div>
        <div><label for="stay-feature">Published feature</label><select id="stay-feature"><option value="all">Any feature</option><option value="dining">Restaurant / dining</option><option value="internet">Internet</option><option value="kitchenette">Kitchenette in some rooms</option></select></div>
        <button id="stay-reset" type="button" class="min-h-12 px-4 border border-basalt/30 hover:bg-sand text-sm">Reset filters</button>
      </div>
      <p id="filter-note" class="text-xs text-basalt/75 leading-relaxed mt-4">Filters reflect published details, including the dated notes below. An unlisted feature is unknown, not necessarily unavailable.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 justify-between mb-6 text-sm text-basalt/75">
      <p id="stay-count" role="status" aria-live="polite" aria-atomic="true">Showing all {accommodations.length} properties</p>
    </div>
    <div id="stay-empty" hidden class="border border-basalt/20 p-8 mb-6">
      <h3 class="font-headline text-3xl mb-3">No matches for these filters.</h3>
      <p class="text-basalt/80 mb-5">Try a different name or a wider choice of area and features. This directory does not show room availability.</p>
      <button type="button" id="stay-empty-reset" class="min-h-12 bg-basalt text-sand px-6 text-sm">Show all properties</button>
    </div>
    <div class="border-t border-basalt/25">
      {accommodations.map((stay, i) => (
        <article id={stay.id} data-stay data-name={stay.name} data-area={stay.area} data-features={stay.features.join(' ')} class="stay-card border-b border-basalt/25 py-8 md:py-10">
          <div>
            <p class="text-xs uppercase tracking-[.15em] text-ochre-deep mb-3">{String(i + 1).padStart(2, '0')} / {stay.area}</p>
            <h3 class="font-headline text-3xl leading-tight mb-3">{stay.name}</h3>
            <p class="text-sm leading-relaxed text-basalt/80">{stay.description}</p>
            <a href={staySources.tourism} class="source-link mt-4 inline-block">Tourism listing &amp; contacts ↗</a>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[.12em] mb-3">Published amenities</h4>
            {stay.dated && <p class="text-xs text-ochre-deep mb-3 font-medium">2025 information · please reconfirm</p>}
            <ul class="text-sm leading-relaxed space-y-2 text-basalt/85">{stay.amenities.map(amenity => <li class="flex gap-2"><span aria-hidden="true" class="text-ochre-deep">—</span><span>{amenity}</span></li>)}</ul>
            <p class="text-sm leading-relaxed text-basalt/80 mt-5"><strong class="text-basalt">Ask before booking:</strong> {stay.ask}</p>
            <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4">{stay.sources.map(source => <a href={source.url} class="source-link">{source.label} ↗</a>)}</div>
          </div>
          <div class="contact-column">
            <h4 class="text-xs font-semibold uppercase tracking-[.12em] mb-3">Contact the property</h4>
            <a href={`tel:${stay.phone}`} aria-label={`Call ${stay.name} at ${phoneLabel(stay.phone)}`} class="contact-link">{phoneLabel(stay.phone)} <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${stay.email}`} aria-label={`Email ${stay.name} at ${stay.email}`} class="contact-link"><span class="break-all">{stay.email}</span><span aria-hidden="true">↗</span></a>
            {stay.website && <a href={stay.website} aria-label={`Visit ${stay.name} website`} class="mt-3 inline-flex min-h-11 items-center gap-4 text-sm font-medium text-lagoon underline underline-offset-4">Property website <span aria-hidden="true">↗</span></a>}
            {!stay.website && <p class="text-xs text-basalt/70 leading-relaxed mt-4">For current room details, use the published phone or email above.</p>}
          </div>
        </article>
      ))}
    </div>
    <p class="text-sm text-basalt/75 leading-relaxed mt-8 max-w-3xl">Room types and facilities can change. The 2025 notes come from WCPFC’s accommodation sheet; other details come from property websites. Confirm your dates, requirements, and total price directly. Listing here is not a quality rating or confirmation that rooms are available.</p>
  </div>
</section>
<script>
  const filters = document.querySelector<HTMLElement>('#stay-filters');
  const search = document.querySelector<HTMLInputElement>('#stay-search');
  const area = document.querySelector<HTMLSelectElement>('#stay-area');
  const feature = document.querySelector<HTMLSelectElement>('#stay-feature');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stay]'));
  const count = document.querySelector<HTMLElement>('#stay-count');
  const empty = document.querySelector<HTMLElement>('#stay-empty');
  const normalize = (value: string) => value.toLocaleLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  if (filters && search && area && feature && count && empty) {
    filters.hidden = false;
    for (const control of [search, area, feature]) control.setAttribute('aria-describedby', 'filter-note');
    const update = () => {
      let visible = 0;
      for (const card of cards) {
        const matches = normalize(card.dataset.name || '').includes(normalize(search.value))
          && (area.value === 'all' || card.dataset.area === area.value)
          && (feature.value === 'all' || (card.dataset.features || '').split(' ').includes(feature.value));
        card.hidden = !matches;
        if (matches) visible++;
      }
      count.textContent = visible === cards.length ? `Showing all ${cards.length} properties` : `Showing ${visible} of ${cards.length} properties`;
      empty.hidden = visible !== 0;
    };
    const reset = () => { search.value = ''; area.value = 'all'; feature.value = 'all'; update(); search.focus(); };
    search.addEventListener('input', update);
    area.addEventListener('change', update);
    feature.addEventListener('change', update);
    document.querySelector('#stay-reset')?.addEventListener('click', reset);
    document.querySelector('#stay-empty-reset')?.addEventListener('click', reset);
    const revealHash = () => {
      const card = cards.find(item => `#${item.id}` === window.location.hash);
      if (card?.hidden) { reset(); card.scrollIntoView(); }
    };
    window.addEventListener('hashchange', revealHash);
    update();
  }
</script>
<style>
  section { scroll-margin-top: 0; }
  [hidden] { display: none !important; }
  .eyebrow { color: #8F4C1E; font-size: .75rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 1rem; }
  label { display: block; font-size: .8rem; font-weight: 500; margin-bottom: .5rem; }
  input, select { width: 100%; min-height: 48px; padding: .75rem; border: 1px solid #2A1F184D; background: #FFF8F1; color: #2A1F18; font-size: 1rem; }
  .stay-card { display: grid; gap: 1.75rem; }
  .source-link { font-size: .75rem; line-height: 1.6; text-decoration: underline; text-underline-offset: 3px; padding-block: .35rem; }
  .source-link:hover { color: #8F4C1E; }
  .contact-link { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: .75rem; border-bottom: 1px solid #2A1F1826; padding: .6rem 0; font-size: .85rem; }
  .contact-link:hover { color: #186969; text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 1024px) { .stay-card { grid-template-columns: 1fr 1.2fr 1fr; gap: 2.5rem; } }
  @media (min-width: 640px) and (max-width: 1023px) { .stay-card { grid-template-columns: 1fr 1fr; } .contact-column { grid-column: 2; } }
</style>
