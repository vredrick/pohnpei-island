---
interface Props { class?: string; variant?: 'geometric' | 'fish'; }
const { class: className = '', variant = 'geometric' } = Astro.props;
const patternId = `tattoo-${variant}-${className || 'default'}`;
---
<!-- Original geometric adaptation of the Pohnpeian tattoo references supplied
     by the owner: solid cuff rails, broad geometric teeth, open panels and filled fish silhouettes.
     Decorative only; no named motif or cultural meaning is asserted. -->
<div class:list={['island-tattoo', `tattoo-${variant}`, className]} aria-hidden="true">
  <svg class="tattoo-track" width="100%" height="48" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs>
      <clipPath id={`${patternId}-panel`}><rect width="120" height="64" /></clipPath>
      <pattern id={patternId} width="160" height="64" patternUnits="userSpaceOnUse" patternTransform="scale(0.75)">
        <!-- Both variants share identical edges, hatching, rails and dividers. -->
        <path d="M0 0H160V2H0ZM0 62H160V64H0Z" fill="currentColor" />
        <g clip-path={`url(#${patternId}-panel)`}>
          <path d="M0 20H120V23H0ZM0 41H120V44H0Z" fill="currentColor" />
          {Array.from({ length: 19 }, (_, i) => i * 8 - 24).map(x => <path d={`M${x} 2h1.5l18 18h-1.5ZM${x} 62h1.5l18-18h-1.5Z`} fill="currentColor" />)}
          {variant === 'geometric'
            ? Array.from({ length: 6 }, (_, i) => i * 20).map(x => <path d={`M${x} 23l20 9-20 9Z`} fill="currentColor" />)
            : [0, 60].map(x => <path data-fish transform={`translate(${x} 0)`} d="M6 24 20 29 34 24 54 32 34 40 20 35 6 40 11 32Z" fill="currentColor" />)}
        </g>
        <g data-wave-divider>
          <path d="M120 0h6v64h-6ZM154 0h6v64h-6Z" fill="currentColor" />
          {[132, 140, 148].map(x => <path d={`M${x} 2q-3 3.75 0 7.5${'t0 7.5'.repeat(7)}`} fill="none" stroke="currentColor" stroke-width="1.2" />)}
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="48" fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  .island-tattoo { width: 100%; height: 48px; overflow: hidden; line-height: 0; }
  /* The 160px source tile renders at 120px wide after scaling: the first and last frames match exactly. */
  .island-tattoo .tattoo-track { display: block; width: calc(100% + 120px); height: 48px; max-width: none; animation: tattoo-current 80s linear infinite; animation-play-state: paused; }
  .tattoo-fish .tattoo-track { animation-duration: 100s; }
  .tattoo-visible .tattoo-track { animation-play-state: running; }
  :global(.motion-paused) .tattoo-track { animation-play-state: paused !important; }
  @keyframes tattoo-current { from { transform: translateX(-120px); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .island-tattoo .tattoo-track { animation: none; } }
</style>
