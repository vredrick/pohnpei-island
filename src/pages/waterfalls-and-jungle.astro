---
import ActivityGuideLayout from '../layouts/ActivityGuideLayout.astro';
import ActivityOperators from '../components/ActivityOperators.astro';
const sections = [{ id: 'places', label: 'Choose a walk' }, { id: 'preparation', label: 'Before setting out' }, { id: 'guides', label: 'Find a guide' }];
const places = [
  { name: 'Kepirohi Waterfall', area: 'Madolenihmw / waterfall visit', description: 'Water spreads over a broad slope of basalt on the lower Mand Stream. The approach follows the river from the road; ask about the current path and entry arrangements.', preparation: 'Plan a viewing visit. The Eco-Adventure Guide warns against swimming here because of water pollution. Ask locally about current conditions; a clear-looking pool is not confirmation of water quality.', source: 'kepirohi' },
  { name: 'Sahwartik & Sahwarlap', area: 'Salapwuk, Kitti / gorge walk', description: 'Two waterfalls meet in the Sahwar Gorge: one tall and narrow, the other broader. Reaching the valley involves a descent and walking beside streams.', preparation: 'Discuss the descent and return climb with a guide. The source describes an unrailed slope and steps that deteriorate after heavy rain. Confirm landowner permission and the condition of the route.', source: 'sahwar-valley' },
  { name: 'Sokehs Ridge', area: 'Sokehs / forest & history', description: 'Also described as Sokehs Mountain or Pohndollap, this ridge combines views with Japanese World War II remains. It is a different outing from climbing Sokehs Rock.', preparation: 'Agree which parts of the ridge you will visit and where to meet your transport. Ask how much climbing and uneven ground the proposed route involves.', source: 'sokehs-mountain' },
  { name: 'The Six Waterfalls Hike', area: 'Salapwuk, Kitti / guided interior route', description: 'The route enters the Nanmeir Valley and follows the upper Lehnmesi River. River crossings and stretches of uneven river stones make it a more involved outing than a waterfall viewpoint.', preparation: 'Arrange a guide who knows this route. Discuss recent rain, crossings and a turnaround plan. The name describes the route, not a promise to reach every waterfall on a particular day.', source: 'six-waterfalls' },
];
---
<ActivityGuideLayout page="waterfalls-and-jungle" title="Waterfalls & Jungle in Pohnpei | Walks, Preparation & Guides" description="Explore Kepirohi, Sahwartik and Sahwarlap, Sokehs Ridge and the Six Waterfalls route, with sourced visiting notes and local hiking contacts." sections={sections}>
  <section slot="hero" class="tg-section bg-sand tapa-pattern"><div class="tg-wrap grid md:grid-cols-[1.5fr_1fr] gap-10 items-end"><div><p class="tg-eyebrow">Pohnpei / Into the forest</p><h1 class="font-headline text-5xl md:text-7xl lg:text-8xl leading-[1.02] tracking-tight mb-7">Waterfalls<br />&amp; <em class="text-ochre-deep">jungle.</em></h1><p class="tg-copy max-w-xl">A waterfall viewpoint, a ridge with a story, or a day following a river inland. Choose the kind of walking you want, then work out the route with someone who knows it.</p><a href="#places" class="tg-button bg-basalt text-sand hover:bg-lagoon mt-7">Explore the walks ↓</a></div><aside class="border-t-2 border-ochre-deep pt-6"><p class="tg-eyebrow">Start with the terrain</p><p class="font-headline text-3xl leading-snug">Distance alone won’t<br />tell you the effort.</p><p class="tg-copy mt-4">Pohnpei’s interior includes indistinct routes, wet ground and steep slopes. Share your fitness and access needs before agreeing on a walk.</p><p class="tg-source">Background: <a class="tg-link" href="https://www.pohnpei-adventure.com/hiking/">Eco-Adventure hiking guide ↗</a></p></aside></div></section>
  <section id="places" class="tg-section bg-sand-bright"><div class="tg-wrap"><div class="tg-split mb-10"><div><p class="tg-eyebrow">01 / Places to explore</p><h2 class="tg-title">Find your <em>kind of walk.</em></h2></div><p class="tg-copy">Use these descriptions to start a conversation with a guide. Confirm access, fees and the route for your date. The linked place guides provide background; they do not establish today’s trail conditions.</p></div><div class="grid md:grid-cols-2 gap-x-12 gap-y-10">{places.map((place, i) => <article class="border-t border-basalt/25 pt-6"><p class="tg-eyebrow">0{i + 1} / {place.area}</p><h3 class="font-headline text-3xl mb-4">{place.name}</h3><div class="tg-copy"><p>{place.description}</p><p>{place.preparation}</p></div><p class="tg-source"><a href={`https://www.pohnpei-adventure.com/${place.source}/`} class="tg-link">Eco-Adventure place guide ↗</a></p></article>)}</div></div></section>
  <section id="preparation" class="tg-section bg-sand"><div class="tg-wrap tg-split"><div><p class="tg-eyebrow">02 / Before setting out</p><h2 class="tg-title">Agree the route.<br /><em>Respect the land.</em></h2><p class="tg-copy">The Eco-Adventure Guide advises local guides for most hikes, especially the interior, and permission before crossing private land. Forest paths can pass through cultivated areas; take care around crops.</p><p class="tg-source">Sources: <a class="tg-link" href="https://www.pohnpei-adventure.com/hiking/">Hiking &amp; land access</a> · <a class="tg-link" href="https://www.pohnpei-adventure.com/waterfalls/">Waterfalls overview</a></p></div><dl class="tg-rows tg-copy"><div><dt>Describe your group</dt><dd>Share walking experience, fitness, children’s ages and access needs. Ask about steep sections, river crossings and alternatives.</dd></div><div><dt>Check the day’s conditions</dt><dd>Ask about recent rain and whether to change or postpone the route. Agree where to turn back and who will know your expected return.</dd></div><div><dt>Settle permissions &amp; transport</dt><dd>Ask who obtains permission, which fees are included and where your return pickup will be. A ride to a trailhead does not establish access to the trail.</dd></div><div><dt>Prepare with your guide</dt><dd>Confirm footwear, drinking water, food, rain protection, a light and first-aid supplies. Ask about the communication plan and what your guide supplies.</dd></div></dl></div></section>
  <section id="guides" class="tg-section bg-sand-bright"><div class="tg-wrap tg-split"><div><p class="tg-eyebrow">03 / Local knowledge</p><h2 class="tg-title">Ask about<br /><em>your chosen route.</em></h2><p class="tg-copy">These businesses publish waterfall or hiking services. Ask specifically about the place you want to visit; a general hiking listing does not confirm every route above.</p><p class="tg-source">Service listings: <a class="tg-link" href="https://visitpohnpei.travel/tour-operators/">Pohnpei Tourism Office</a>. Contact details live in our shared directory.</p><a href="/tour-operators?service=hiking#directory" class="tg-button bg-basalt text-sand hover:bg-lagoon mt-6">Compare hiking contacts →</a></div><ActivityOperators service="hiking" /></div></section>
</ActivityGuideLayout>
