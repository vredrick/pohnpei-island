---
import Icon from './home/Icon.astro';
import { sources } from '../data/nan-madol';
import { nanMadolOperators as operators } from '../data/operators';
import OperatorContacts from './OperatorContacts.astro';
---
<section id="local-guides" aria-labelledby="guides-title" class="bg-sand-deep px-6 py-16 md:py-24">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-8 mb-10">
      <div>
        <p class="text-ochre-deep text-xs uppercase tracking-[0.2em] font-semibold mb-4">04 / Your next step</p>
        <h2 id="guides-title" class="font-headline text-4xl md:text-5xl leading-tight">Go with a <em class="text-ochre-deep">local guide.</em></h2>
      </div>
      <div class="text-sm leading-relaxed text-basalt/80 space-y-3">
        <p>These six businesses list Nan Madol services in the <a href={sources.operators} class="underline underline-offset-4">Pohnpei Tourism Office directory</a>. Listed alphabetically; contact operators directly to discuss your visit.</p>
        <p>We have not contacted these businesses to confirm availability. PohnpeiIsland.com is an independent guide; listings are not endorsements or bookings.</p>
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {operators.map((operator, index) => (
        <article id={operator.id} aria-labelledby={`${operator.id}-title`} class="bg-sand-bright border border-basalt/15 p-6 md:p-8 min-w-0 flex flex-col">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 id={`${operator.id}-title`} class="font-headline text-2xl md:text-3xl">{operator.name}</h3>
            <span aria-hidden="true" class="font-headline text-xl text-basalt/50">0{index + 1}</span>
          </div>
          <p class="text-sm text-basalt/80 mb-5">{operator.services}</p>
          {operator.paused && <p class="border-l-2 border-ochre-deep pl-4 text-sm leading-relaxed mb-5"><strong>Tours temporarily suspended.</strong> The operator’s website says tours and new bookings are paused. Check its website for reopening news; the contacts below are for updates.</p>}
          <OperatorContacts operator={operator} />
          <p class="text-xs text-basalt/70 mt-6 pt-4 border-t border-basalt/10"><a href={operator.source} class="underline underline-offset-4">{operator.paused ? 'Operator’s own website' : 'Tourism office listing'}</a></p>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm leading-relaxed text-basalt/80">Looking beyond Nan Madol? <a href="/tour-operators" class="underline underline-offset-4">Browse all guides &amp; transport <Icon name="arrow" /></a> Need help finding another option? <a href={sources.contact} class="underline underline-offset-4">Contact the Pohnpei Tourism Office <Icon name="arrow" /></a></p>
  </div>
</section>
<style>section { scroll-margin-top: 0; }</style>
